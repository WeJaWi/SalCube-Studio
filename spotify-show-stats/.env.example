# ─────────────────────────────────────────────────────────────
#  spotify-show-stats — copy to .env and fill in.
#    cp .env.example .env
#
#  Create an app at https://developer.spotify.com/dashboard
#  (any name; no redirect URI is needed — this tool uses the
#  app-only client-credentials flow, so it never touches your
#  personal Spotify account or asks you to log in).
#
#  These two keys may also live in the studio's root .env —
#  the tool reads that file too.
# ─────────────────────────────────────────────────────────────
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Default catalogue market (ISO country code). Overridable with --market.
# Shows are licensed per country, so a show missing in one market can be
# present in another.
SPOTIFY_MARKET=US
