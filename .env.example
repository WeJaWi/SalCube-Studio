# ─────────────────────────────────────────────────────────────
#  Copy this file to .env and fill in your keys.
#  cp .env.example .env
#  (kie/ai33/Pixabay keys are the same as ~/video-studio.)
# ─────────────────────────────────────────────────────────────

# How many videos render at once. 1 = old serial behavior (safest — no
# multiplied API spend rate). "auto" sizes it to this machine's detected
# cores/RAM. Local render is CPU-bound (FFmpeg); every other step is a
# remote API call, so raising this trades CPU contention and provider
# rate limits for throughput.
MAX_CONCURRENT_JOBS=1

# How many beats of ONE video are composited in parallel. "auto" sizes it
# to cores (tighter when GPU encode is on — see below). 1 = old serial
# per-beat behavior.
BEAT_RENDER_WORKERS=auto

# ── Sonnet 5 via kie.ai (outline, hooks, script, beat plan) ────
LLM_API_KEY=your-kie-key
LLM_BASE_URL=https://api.kie.ai
LLM_CHAT_PATH=/claude/v1/messages
LLM_MODEL=claude-sonnet-5

# ── Claude CLI fallback, used when kie.ai's script model returns
# repeated 5xx errors (its normal retry budget already exhausted).
# Shells out to the `claude` CLI already installed/logged in on this
# machine, billed against this Claude subscription's usage rather than
# the kie API key. Set to false to disable and only ever use kie.ai.
CLAUDE_CLI_FALLBACK=true
CLAUDE_CLI_PATH=claude
CLAUDE_CLI_MODEL=sonnet
CLAUDE_CLI_TIMEOUT=300

# ── kie.ai (AI b-roll + fallback images) ───────────────────────
KIE_API_KEY=your-kie-key
KIE_BASE_URL=https://api.kie.ai
# kie's file upload API lives on a separate host
KIE_UPLOAD_BASE_URL=https://kieai.redpandaai.co
KIE_IMAGE_MODEL=z-image
# Cheapest text-to-video for b-roll (exact 6-30s durations).
# The kie key must be authorized for this model (kie dashboard → API Keys).
KIE_VIDEO_MODEL=grok-imagine/text-to-video

# ── Thumbnail tool (standalone — separate from the video pipeline) ──
# Own kie.ai key so its spend is tracked apart from the video-gen credits.
KIE_THUMBNAIL_API_KEY=
KIE_THUMBNAIL_MODEL=gpt-image-2-image-to-image
# gpt-image-2 has no quality field, only resolution (1K/2K/4K) — 2K = "medium"
KIE_THUMBNAIL_RESOLUTION=2K

# ── HeyGen (Hannah on camera: intro + split-screens) ───────────
HEYGEN_API_KEY=your-heygen-key
# For a photo avatar (a "look" inside an avatar group), set the look id and
# type talking_photo. For a video avatar, use its avatar_id and type avatar.
HEYGEN_AVATAR_ID=your-avatar-or-talking-photo-id
HEYGEN_AVATAR_TYPE=talking_photo
HEYGEN_AVATAR_STYLE=normal

# ── ai33.pro (full-narration voiceover + subtitles, Suno music) ─
AI33_API_KEY=your-ai33-key
AI33_BASE_URL=https://api.ai33.pro
# Fallback narrator voice (profiles override per language)
AI33_VOICE_ID=elevenlabs_21m00Tcm4TlvDq8ikWAM
AI33_TTS_SPEED=1
# Chars per TTS call — beats are grouped up to this size and voiced in one
# pass instead of one call per beat (fewer prosody-reset boundaries).
# Tested clean at 40k chars (~40 min) against the real API; raise only
# after testing higher, since a silent-truncation safety net exists but
# hasn't been exercised past this value.
AI33_MAX_TTS_CHARS=40000

# ── Pixabay (stock b-roll) ─────────────────────────────────────
PIXABAY_API_KEY=your-pixabay-key

# ── Optional: font used for burned subtitles ───────────────────
CAPTION_FONT_FILE=

# ── Google Drive (completed deliverables; one-time browser consent) ──
# Download a Desktop OAuth client JSON from Google Cloud. It stays outside
# the repository; the refresh token is saved at output/gdrive_token.json.
GDRIVE_CLIENT_SECRET_FILE=
GDRIVE_TOKEN_FILE=
# App root. A child folder is created automatically for every video profile.
GDRIVE_FOLDER_NAME=videos
GDRIVE_CHUNK_MB=8
# Leave blank for http://localhost:<app-port>/api/drive/callback.
GDRIVE_REDIRECT_URI=

# ── Render fleet (set after Tailscale is installed on both machines) ──
# Mac/main: FLEET_ROLE=main. Windows/render machine: FLEET_ROLE=worker,
# FLEET_MAIN_URL=http://100.x.y.z:5066 and the SAME random pairing token.
FLEET_ROLE=off
FLEET_MAIN_URL=
FLEET_PAIRING_TOKEN=
FLEET_WORKER_ID=
FLEET_WORKER_NAME=
FLEET_MAX_JOBS=1
FLEET_HEARTBEAT_SECONDS=5
FLEET_STALE_SECONDS=120

# ── Added later (see README) ────────────────────────────────────
AI33_API_KEY=your-ai33-key
KIE_VIDEO_API_KEY=kie-key-authorized-for-video-models
PIXABAY_IMAGE_API_KEY=second-pixabay-key-for-photos
LLM_GPT_API_KEY=kie-key-for-gpt-5.6
# Read-only one-minute operations observer, chat, and reports.
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key
OPENROUTER_MONITOR_MODEL=qwen/qwen3.7-flash
# Grok 4.5 script model — falls back to KIE_API_KEY if left blank, but that
# key must be separately authorized for grok-4-5 on the kie.ai dashboard
# (API Keys → model access) or every call fails with a 401 wrapped in a 200.
LLM_GROK_API_KEY=
PEXELS_API_KEY=your-pexels-key
# Optional multi-user login: name:key:profiles ("*" = all, "|"-separated)
ACCESS_KEYS=
